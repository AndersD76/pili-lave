// PROGRAMA DA LOJA — banco LOCAL (SQLite) do computador central de cada
// loja de conveniência. Cada loja tem o seu, independente: produtos,
// estoque, entradas de mercadoria. A nuvem (server/) só guarda o cadastro
// da loja, usuários e carteira.
//
// O arquivo fica em loja/dados/loja.db e é criado sozinho na primeira
// execução (npm run dev / npm start rodam `prisma migrate deploy` antes).
//
// SQLite não tem enum: os campos "tipo"/"origem" são texto, com os valores
// possíveis listados em lib/estoque.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../dados/loja.db"
}

/// Configuração da própria loja, em pares chave/valor: identidade do
/// computador (deviceKey), loja vinculada na nuvem, segredo da sessão…
/// Ver lib/config.ts pra lista de chaves.
model Config {
  chave String @id
  valor String
}

/// Quem opera a gestão neste computador. LOJISTA = o dono da loja (definido
/// pelo admin na nuvem; entra com o e-mail e a senha do app, conferidos na
/// nuvem — a senha fica copiada aqui só pra entrar sem internet). FUNCIONARIO
/// = cadastrado pelo lojista aqui, com as permissões que ele marcar.
model Usuario {
  id          String   @id @default(cuid())
  nome        String
  /// Funcionário: nome de usuário escolhido pelo lojista. Lojista: o e-mail.
  login       String   @unique
  senhaHash   String
  /// LOJISTA | FUNCIONARIO
  papel       String
  /// Lista de permissões em JSON (ver lib/permissoes.ts). Lojista ignora:
  /// tem acesso total.
  permissoes  String   @default("[]")
  ativo       Boolean  @default(true)
  /// Id do usuário na nuvem — só o lojista tem.
  nuvemUserId String?  @unique
  criadoEm    DateTime @default(now())

  atividades Atividade[]
}

/// Registro de TUDO que alguém fez na gestão (quem, quando, o quê). Só
/// cresce: nenhuma tela edita ou apaga.
model Atividade {
  id          String   @id @default(cuid())
  usuarioId   String
  /// Nome na hora da ação — continua legível mesmo se o usuário for renomeado.
  usuarioNome String
  /// ENTROU | PRODUTO_CRIADO | PRODUTO_ALTERADO | PRECO_ALTERADO | ENTRADA |
  /// PERDA | INVENTARIO | USUARIO_CRIADO | USUARIO_ALTERADO
  acao        String
  detalhe     String
  produtoId   String?
  criadoEm    DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([criadoEm])
  @@index([usuarioId, criadoEm])
}

model Produto {
  id            String   @id @default(cuid())
  /// Código de barras. Opcional: existe produto sem EAN (item avulso).
  ean           String?  @unique
  nome          String
  unidade       String   @default("UN")
  /// Último custo de compra (vem da nota de entrada).
  custoCents    Int      @default(0)
  /// Preço de venda. null = ainda sem preço — NÃO pode ser vendido no totem
  /// (é como nasce um produto criado por uma nota de entrada).
  precoCents    Int?
  /// Cache do saldo — a fonte da verdade é a soma de Movimento.
  estoqueAtual  Int      @default(0)
  estoqueMinimo Int      @default(5)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  movimentos   Movimento[]
  entradaItens EntradaItem[]
  codigos      CodigoFornecedor[]

  @@index([nome])
}

/// Extrato do estoque: TODA mudança de saldo passa por aqui (nunca se mexe
/// em Produto.estoqueAtual direto — ver lib/estoque.ts).
model Movimento {
  id         String   @id @default(cuid())
  produtoId  String
  /// ENTRADA | VENDA | PERDA | AJUSTE
  tipo       String
  /// Positivo soma, negativo baixa.
  quantidade Int
  /// Saldo do produto logo depois deste movimento.
  saldoApos  Int
  nota       String?
  /// Quem lançou (Usuario.id). null = venda no totem, ou movimento anterior
  /// ao cadastro de usuários.
  usuarioId  String?
  /// Entrada.id (entrada de nota) ou, no futuro, o id da venda no totem.
  refId      String?
  criadoEm   DateTime @default(now())
  /// Quando este movimento foi enviado pra nuvem (indicadores) — null =
  /// ainda na fila. A sincronização em si entra na etapa 3.
  sincronizadoEm DateTime?

  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([produtoId, criadoEm])
  @@index([tipo, criadoEm])
}

model Fornecedor {
  id   String @id @default(cuid())
  cnpj String @unique // só dígitos
  nome String

  entradas Entrada[]
  codigos  CodigoFornecedor[]
}

/// Uma entrada de mercadoria (uma nota fiscal, ou um lançamento manual).
model Entrada {
  id           String   @id @default(cuid())
  /// XML | PDF | MANUAL
  origem       String
  numeroNf     String?
  /// Chave de acesso da NF-e (44 dígitos) — única: a mesma nota não entra
  /// duas vezes.
  chaveNfe     String?  @unique
  dataEmissao  DateTime?
  fornecedorId String?
  totalCents   Int      @default(0)
  /// Quem deu a entrada (Usuario.id).
  usuarioId    String?
  criadaEm     DateTime @default(now())

  fornecedor Fornecedor?   @relation(fields: [fornecedorId], references: [id])
  itens      EntradaItem[]

  @@index([criadaEm])
}

model EntradaItem {
  id               String @id @default(cuid())
  entradaId        String
  produtoId        String
  /// Como o item veio escrito na nota (código e descrição do fornecedor).
  codigoFornecedor String?
  descricao        String
  quantidade       Int
  custoUnitCents   Int

  entrada Entrada @relation(fields: [entradaId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([entradaId])
}

/// Memória de "o código X deste fornecedor é o produto Y" — o PDF da nota
/// (DANFE) quase nunca traz o código de barras, só o código interno do
/// fornecedor. Na segunda nota a conferência já vem preenchida.
model CodigoFornecedor {
  fornecedorId String
  codigo       String
  produtoId    String

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id])
  produto    Produto    @relation(fields: [produtoId], references: [id])

  @@id([fornecedorId, codigo])
}
