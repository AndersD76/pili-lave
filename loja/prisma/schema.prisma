// PROGRAMA DA LOJA — banco LOCAL (SQLite) do computador central de cada
// loja de conveniência. Cada loja tem o seu, independente: produtos,
// estoque, entradas de mercadoria. A nuvem (server/) só guarda o cadastro
// da loja, usuários e carteira.
//
// O arquivo fica em loja/dados/loja.db e é criado sozinho na primeira
// execução (npm run dev / npm start rodam `prisma migrate deploy` antes).
//
// SQLite não tem enum: os campos "tipo"/"origem" são texto, com os valores
// possíveis listados em lib/estoque.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../dados/loja.db"
}

/// Configuração da própria loja, em pares chave/valor: identidade do
/// computador (deviceKey), loja vinculada na nuvem, segredo da sessão…
/// Ver lib/config.ts pra lista de chaves.
model Config {
  chave String @id
  valor String
}

/// Quem opera a gestão neste computador. LOJISTA = o dono da loja (definido
/// pelo admin na nuvem; entra com o e-mail e a senha do app, conferidos na
/// nuvem — a senha fica copiada aqui só pra entrar sem internet). FUNCIONARIO
/// = cadastrado pelo lojista aqui, com as permissões que ele marcar.
model Usuario {
  id          String   @id @default(cuid())
  nome        String
  /// Funcionário: nome de usuário escolhido pelo lojista. Lojista: o e-mail.
  login       String   @unique
  senhaHash   String
  /// LOJISTA | FUNCIONARIO
  papel       String
  /// Lista de permissões em JSON (ver lib/permissoes.ts). Lojista ignora:
  /// tem acesso total.
  permissoes  String   @default("[]")
  ativo       Boolean  @default(true)
  /// Id do usuário na nuvem — só o lojista tem.
  nuvemUserId String?  @unique
  criadoEm    DateTime @default(now())

  atividades Atividade[]
}

/// Registro de TUDO que alguém fez na gestão (quem, quando, o quê). Só
/// cresce: nenhuma tela edita ou apaga.
model Atividade {
  id          String   @id @default(cuid())
  usuarioId   String
  /// Nome na hora da ação — continua legível mesmo se o usuário for renomeado.
  usuarioNome String
  /// ENTROU | PRODUTO_CRIADO | PRODUTO_ALTERADO | PRECO_ALTERADO | ENTRADA |
  /// PERDA | INVENTARIO | USUARIO_CRIADO | USUARIO_ALTERADO
  acao        String
  detalhe     String
  produtoId   String?
  criadoEm    DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([criadoEm])
  @@index([usuarioId, criadoEm])
}

model Produto {
  id            String   @id @default(cuid())
  /// Código de barras. Opcional: existe produto sem EAN (item avulso).
  ean           String?  @unique
  nome          String
  unidade       String   @default("UN")
  /// Último custo de compra (vem da nota de entrada).
  custoCents    Int      @default(0)
  /// Preço de venda. null = ainda sem preço — NÃO pode ser vendido no totem
  /// (é como nasce um produto criado por uma nota de entrada).
  precoCents    Int?
  /// Percentual de venda sobre o custo (30 = custo + 30%). Com ele
  /// preenchido e precoManual desligado, o preço é SEMPRE custo × (1 + %),
  /// recalculado sozinho quando o custo muda (ver lib/precos.ts).
  /// null = produto ainda sem percentual.
  margemPct     Float?
  /// true = o lojista fixou o preço à mão: não sofre reajuste automático
  /// quando o custo muda. Esses produtos aparecem numa lista própria.
  precoManual   Boolean  @default(false)
  /// Cache do saldo — a fonte da verdade é a soma de Movimento.
  estoqueAtual  Int      @default(0)
  estoqueMinimo Int      @default(5)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  movimentos   Movimento[]
  entradaItens EntradaItem[]
  codigos      CodigoFornecedor[]
  vendaItens   VendaItem[]
  itemCompra   ItemCompra?
  fornecedores ProdutoFornecedor[]

  @@index([nome])
}

/// Lista de compras: um produto marcado pra comprar, com a quantidade
/// desejada. Sai da lista sozinho quando o produto recebe uma entrada
/// (nota fiscal ou manual) — ver movimentar() em lib/estoque.ts.
model ItemCompra {
  produtoId  String   @id
  quantidade Int
  /// De qual fornecedor (da tela de Compras por fornecedor) — null quando
  /// marcado na aba "Sem fornecedor". É o que faz o item sumir das OUTRAS
  /// telas de fornecedor enquanto esta marcação existir (ver lib/compras.ts).
  fornecedorId String?
  /// Quem marcou (Usuario.id).
  usuarioId  String
  criadoEm   DateTime @default(now())

  produto    Produto     @relation(fields: [produtoId], references: [id])
  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id])
}

/// Vínculo manual "este produto pode ser comprado deste fornecedor" — pra
/// decidir quem vende o quê, sem depender de já ter aparecido numa nota
/// (ver CodigoFornecedor, que é o aprendizado automático do código usado
/// pelo fornecedor, coisa diferente). Cadastrado na ficha do produto.
model ProdutoFornecedor {
  produtoId    String
  fornecedorId String
  criadoEm     DateTime @default(now())

  produto    Produto    @relation(fields: [produtoId], references: [id])
  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id])

  @@id([produtoId, fornecedorId])
}

/// Extrato do estoque: TODA mudança de saldo passa por aqui (nunca se mexe
/// em Produto.estoqueAtual direto — ver lib/estoque.ts).
model Movimento {
  id         String   @id @default(cuid())
  produtoId  String
  /// ENTRADA | VENDA | PERDA | AJUSTE
  tipo       String
  /// Positivo soma, negativo baixa.
  quantidade Int
  /// Saldo do produto logo depois deste movimento.
  saldoApos  Int
  nota       String?
  /// Quem lançou (Usuario.id). null = venda no totem, ou movimento anterior
  /// ao cadastro de usuários.
  usuarioId  String?
  /// Entrada.id (entrada de nota) ou, no futuro, o id da venda no totem.
  refId      String?
  criadoEm   DateTime @default(now())
  /// Quando este movimento foi enviado pra nuvem (indicadores) — null =
  /// ainda na fila. A sincronização em si entra na etapa 3.
  sincronizadoEm DateTime?

  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([produtoId, criadoEm])
  @@index([tipo, criadoEm])
}

/// Uma venda fechada no caixa de autoatendimento (tela do cliente).
model Venda {
  /// Número da venda nesta loja (1, 2, 3…) — é o que aparece na tela.
  id         Int      @id @default(autoincrement())
  /// Identificador único no mundo: é por ele que a venda vai ser enviada
  /// pra nuvem sem risco de duplicar (sincronização, etapa seguinte).
  codigo     String   @unique @default(cuid())
  totalCents Int
  /// SIMULADO (teste, sem cobrança) | CARTEIRA | MAQUININHA
  forma      String
  criadaEm   DateTime @default(now())
  sincronizadaEm DateTime?
  /// Venda desfeita pela gestão (erro, desistência depois de pagar). O
  /// registro fica — não se apaga venda — só marcado.
  canceladaEm        DateTime?
  motivoCancelamento String?

  itens VendaItem[]

  @@index([criadaEm])
}

/// Uma cobrança pedida à maquininha. Existe pra separar "a máquina
/// aprovou" de "a venda foi gravada" — o mesmo desenho da carteira
/// (identificar/confirmar). Hoje só tem o driver manual (ver
/// lib/maquininha/): o operador confirma pelo visor dela mesmo. Quando uma
/// maquininha de verdade for integrada, essa tabela e as rotas continuam
/// as mesmas — só o driver em lib/maquininha/index.ts muda.
model OperacaoCartao {
  id          String    @id @default(cuid())
  totalCents  Int
  /// AGUARDANDO | APROVADO | RECUSADO
  situacao    String    @default("AGUARDANDO")
  /// Comprovante/id que a maquininha devolver, quando houver.
  referencia  String?
  motivo      String?
  criadaEm    DateTime  @default(now())
  concluidaEm DateTime?
}

model VendaItem {
  id             String @id @default(cuid())
  vendaId        Int
  produtoId      String
  /// Nome, código e preço COMO ESTAVAM na hora da venda — o cadastro do
  /// produto pode mudar depois; a venda não.
  nome           String
  ean            String?
  quantidade     Int
  precoUnitCents Int

  venda   Venda   @relation(fields: [vendaId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([vendaId])
}

model Fornecedor {
  id   String @id @default(cuid())
  cnpj String @unique // só dígitos
  nome String
  /// Valor mínimo de pedido (R$, em centavos) — abaixo disso não vale a
  /// pena pedir. null = sem mínimo cadastrado (nenhum aviso é mostrado).
  pedidoMinimoCents Int?

  entradas    Entrada[]
  codigos     CodigoFornecedor[]
  produtos    ProdutoFornecedor[]
  itensCompra ItemCompra[]
}

/// Uma entrada de mercadoria (uma nota fiscal, ou um lançamento manual).
model Entrada {
  id           String   @id @default(cuid())
  /// XML | PDF | MANUAL
  origem       String
  numeroNf     String?
  /// Chave de acesso da NF-e (44 dígitos) — única: a mesma nota não entra
  /// duas vezes.
  chaveNfe     String?  @unique
  dataEmissao  DateTime?
  fornecedorId String?
  totalCents   Int      @default(0)
  /// Quem deu a entrada (Usuario.id).
  usuarioId    String?
  criadaEm     DateTime @default(now())

  fornecedor Fornecedor?   @relation(fields: [fornecedorId], references: [id])
  itens      EntradaItem[]

  @@index([criadaEm])
}

model EntradaItem {
  id               String @id @default(cuid())
  entradaId        String
  produtoId        String
  /// Como o item veio escrito na nota (código e descrição do fornecedor).
  codigoFornecedor String?
  descricao        String
  quantidade       Int
  custoUnitCents   Int

  entrada Entrada @relation(fields: [entradaId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([entradaId])
}

/// Nota fiscal já enviada (XML) e ainda NÃO conferida: fica aqui entre o
/// envio do arquivo e a confirmação dos itens. Confirmar vira uma Entrada e
/// apaga esta linha; descartar só apaga.
model NotaPendente {
  id        String   @id @default(cuid())
  xml       String
  usuarioId String
  criadaEm  DateTime @default(now())
}

/// Memória de "o código X deste fornecedor é o produto Y" — o PDF da nota
/// (DANFE) quase nunca traz o código de barras, só o código interno do
/// fornecedor. Na segunda nota a conferência já vem preenchida.
model CodigoFornecedor {
  fornecedorId String
  codigo       String
  produtoId    String

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id])
  produto    Produto    @relation(fields: [produtoId], references: [id])

  @@id([fornecedorId, codigo])
}

/// Cópia mínima dos clientes que podem entrar nesta loja (vem da nuvem,
/// ver lib/sincronizacaoLoja.ts). A FOTO do rosto nunca fica aqui: é
/// repassada direto ao serviço de reconhecimento (rosto/), que guarda só a
/// assinatura. `bloqueado` = bloqueio do dono, decidido na nuvem.
model ClienteLocal {
  nuvemUserId   String   @id
  codigoCliente String   @unique
  nome          String
  bloqueado     Boolean  @default(false)
  /// true = o serviço de reconhecimento confirmou que cadastrou o rosto.
  temRosto      Boolean  @default(false)
  atualizadoEm  DateTime @default(now())
}

/// Uma pessoa dentro da loja, da entrada autorizada até a saída. Quem
/// autoriza é sempre lib/visitas.ts, seja qual for o equipamento da porta.
model Visita {
  id            String    @id @default(cuid())
  /// null só em visita lançada sem cadastro (origem MANUAL/REMOTA).
  nuvemUserId   String?
  codigoCliente String?
  /// Nome na hora da entrada — é o que o totem mostra em "Você é: …?".
  nome          String
  criancas      Int       @default(0)
  entrouEm      DateTime  @default(now())
  /// null = ainda está dentro.
  saiuEm        DateTime?
  /// CATRACA | BLE | MANUAL | REMOTA
  origem        String
  /// Venda.id da compra desta visita (a última, se houver mais de uma).
  vendaId       Int?
  saiuSemPagar  Boolean   @default(false)

  @@index([saiuEm])
  @@index([entrouEm])
}

/// O que as câmeras (visao/) mandam: algo mudou numa zona de prateleira,
/// alguém passou pela porta, ou uma câmera saiu do ar/desalinhou.
model EventoVisao {
  id            String   @id @default(cuid())
  /// PRATELEIRA | PORTA | CAMERA
  tipo          String
  zona          String?
  /// PRATELEIRA: unidades que mudaram na zona (negativo = saiu da
  /// prateleira, positivo = voltou/foi reposto). PORTA: +1 entrou, -1 saiu.
  delta         Int      @default(0)
  /// JSON: ids das visitas que estavam na zona, como a câmera mandou.
  visitasNaZona String   @default("[]")
  /// Duas ou mais visitas na zona: não dá pra dizer de quem foi.
  ambiguo       Boolean  @default(false)
  /// Visita a que o evento foi atribuído (uma só na zona).
  visitaId      String?
  /// Aconteceu durante uma reposição: é do repositor, não gera divergência.
  reposicaoId   String?
  /// JSON: caminhos locais das imagens do momento.
  imagens       String   @default("[]")
  detalhe       String?
  ocorridoEm    DateTime
  criadoEm      DateTime @default(now())
  divergenciaId String?

  divergencia Divergencia? @relation(fields: [divergenciaId], references: [id])

  @@index([ocorridoEm])
  @@index([tipo, ocorridoEm])
}

/// Fechamento de um período (de loja vazia até loja vazia) em que o que
/// saiu das prateleiras não bateu com o que foi pago. Vai pra revisão do
/// dono — nunca gera cobrança sozinha.
model Divergencia {
  id             String    @id @default(cuid())
  inicio         DateTime
  fim            DateTime
  /// Unidades que saíram das prateleiras no período (fora reposição).
  saiuPrateleira Int
  /// Unidades pagas no caixa no período (vendas não canceladas).
  pago           Int
  /// JSON: [{visitaId, nome}] de quem esteve na loja no período.
  visitas        String    @default("[]")
  /// ABERTA | REVISADA
  situacao       String    @default("ABERTA")
  decisao        String?
  revisadaPor    String?
  revisadaEm     DateTime?
  criadaEm       DateTime  @default(now())

  eventos EventoVisao[]

  @@index([situacao, criadaEm])
}

/// Modo reposição: enquanto está aberta (fim = null) a loja não deixa
/// cliente entrar e o que mudar nas prateleiras é de quem está repondo.
model Reposicao {
  id          String    @id @default(cuid())
  usuarioId   String
  usuarioNome String
  inicio      DateTime  @default(now())
  fim         DateTime?

  @@index([fim])
}

/// Fila de avisos pro dono (vão pro app pela nuvem). Fica aqui até a nuvem
/// confirmar — sem internet, acumula e vai depois (lib/alertas.ts).
model AlertaNuvem {
  /// Identificador único: reenviar o mesmo aviso não duplica na nuvem.
  codigo     String    @id @default(cuid())
  /// ESTOQUE_MINIMO | DIVERGENCIA | SAIDA_SEM_PAGAR | INVASAO
  tipo       String
  titulo     String
  detalhe    String
  /// JSON: caminhos locais das imagens (viram base64 só na hora de enviar).
  imagens    String    @default("[]")
  ocorridoEm DateTime  @default(now())
  enviadoEm  DateTime?

  @@index([enviadoEm])
}

/// Aberturas remotas da porta pedidas pelo lojista no app e já executadas
/// aqui — existe pra mesma ordem nunca abrir a porta duas vezes.
model AberturaRemota {
  id        String   @id
  pedidaPor String
  abertaEm  DateTime @default(now())
  ok        Boolean  @default(true)
}
