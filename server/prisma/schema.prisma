// PILI LAVE — schema (Postgres/Neon)
// DATABASE_URL = string POOLED do Neon (…-pooler…)  → runtime
// DIRECT_URL   = string DIRETA (sem -pooler)        → migrations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  LAVADOR
  ADMIN
}

enum TopupStatus {
  PENDING
  PAID
  CANCELED
}

enum OrderStatus {
  PAID      // voucher emitido, aguardando resgate
  REDEEMED  // lavador escaneou e liberou
  CANCELED  // estorno p/ carteira
}

enum WalletTxKind {
  TOPUP  // recarga confirmada (+)
  WASH   // compra de lavagem (-)
  REFUND // estorno (+)
  ADJUST // ajuste manual admin (+/-)
}

enum ReservationStatus {
  HELD      // saldo bloqueado (não debitado), aguardando uso — validade 1h
  ACTIVE    // placa reconhecida + máquina livre — verde aceso, aguardando entrar
  ENTERED   // X14 confirmou o carro dentro — cancelamento bloqueado
  COMPLETED // AUTO_CONCLUIDO — único ponto de débito
  EXPIRED   // 1h sem uso — saldo liberado sem estorno
  CANCELED  // motorista cancelou antes do X14
  FAILED    // AUTO_ERRO ou timeout de segurança — saldo liberado, sem débito
}

enum MachineStatus {
  FREE        // livre, heartbeat ok
  WASHING     // ciclo em andamento
  FAULT       // AUTO_ERRO reportado
  OFFLINE     // sem heartbeat há 60s+
  MAINTENANCE // parada programada pelo admin
}

model User {
  id              String   @id @default(cuid())
  phone           String   @unique // E.164: +5554999999999
  name            String?
  cpf             String?
  role            Role     @default(CLIENT)
  asaasCustomerId String?
  walletCents     Int      @default(0) // cache; fonte da verdade = WalletTx
  createdAt       DateTime @default(now())

  vehicles     Vehicle[]
  topups       Topup[]
  orders       Order[]
  walletTxs    WalletTx[]
  redemptions  Order[]       @relation("redeemedBy")
  arrivals     Arrival[]
  reservations Reservation[]
}

model Otp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Vehicle {
  id               String   @id @default(cuid())
  userId           String
  plate            String // normalizada: ABC1D23 / ABC1234 (sem hífen)
  brand            String?
  model            String?
  color            String?
  year             String?
  defaultProgramId Int?
  createdAt        DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id])
  defaultProgram Program? @relation(fields: [defaultProgramId], references: [id])
  orders         Order[]
  arrivals       Arrival[]
  reservations   Reservation[]

  @@unique([userId, plate])
}

model Program {
  id         Int     @id // 1..4
  nome       String
  precoCents Int
  duracaoMin Int     @default(30) // duração do ciclo (timeout de segurança = 2x)
  ordem      Int     @default(0)
  ativo      Boolean @default(true)

  vehicles     Vehicle[]
  orders       Order[]
  reservations Reservation[]
}

model Topup {
  id             String      @id @default(cuid())
  userId         String
  amountCents    Int
  method         String // PIX | CARD
  status         TopupStatus @default(PENDING)
  asaasPaymentId String?     @unique
  pixPayload     String? // copia-e-cola (vira QR no app)
  invoiceUrl     String? // checkout p/ cartão
  createdAt      DateTime    @default(now())
  paidAt         DateTime?

  user User @relation(fields: [userId], references: [id])
}

model Order {
  id               String      @id @default(cuid())
  userId           String
  vehicleId        String?
  programId        Int
  amountCents      Int // preço no momento da compra
  status           OrderStatus @default(PAID)
  voucherCode      String      @unique // conteúdo do QR: PILILAVE:<code>
  voucherExpiresAt DateTime?
  createdAt        DateTime    @default(now())
  redeemedAt       DateTime?
  redeemedById     String?

  user        User         @relation(fields: [userId], references: [id])
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id])
  program     Program      @relation(fields: [programId], references: [id])
  redeemedBy  User?        @relation("redeemedBy", fields: [redeemedById], references: [id])
  arrival     Arrival?
  reservation Reservation?

  @@index([userId, createdAt])
}

model WalletTx {
  id          String       @id @default(cuid())
  userId      String
  amountCents Int // positivo credita, negativo debita
  kind        WalletTxKind
  refId       String? // Topup.id ou Order.id
  note        String?
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum ArrivalStatus {
  WAITING_DRIVER // placa reconhecida, aguardando o motorista solicitar
  NO_MATCH       // placa sem cadastro
  REQUESTED      // motorista pagou — máquina deve liberar (luz verde)
  STARTED        // máquina confirmou o início
  EXPIRED        // ninguém solicitou a tempo
}

// Chegada de veículo na máquina (leitura da câmera LPR)
model Arrival {
  id            String        @id @default(cuid())
  plate         String        // normalizada
  vehicleId     String?
  userId        String?
  status        ArrivalStatus @default(WAITING_DRIVER)
  orderId       String?       @unique
  reservationId String?
  stationId     String?
  createdAt     DateTime      @default(now())
  requestedAt   DateTime?
  startedAt     DateTime?

  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
  order       Order?       @relation(fields: [orderId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  station     WashStation? @relation(fields: [stationId], references: [id])

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// Unidade de lavagem (endereço + coordenadas p/ geolocalização no app)
model WashStation {
  id        String   @id @default(cuid())
  name      String
  address   String   @default("")
  city      String   @default("")
  state     String   @default("RS")
  lat       Float?
  lng       Float?
  active    Boolean  @default(true)
  timezone  String   @default("America/Sao_Paulo")
  createdAt DateTime @default(now())

  machines     Machine[]
  reservations Reservation[]
  arrivals     Arrival[]
}

// Máquina física — um ESP32 (deviceKey próprio) por máquina
model Machine {
  id            String        @id @default(cuid())
  stationId     String
  name          String        @default("Máquina 1")
  deviceKey     String        @unique
  status        MachineStatus @default(FREE)
  lastHeartbeat DateTime?
  remainingSec  Int           @default(0)
  // luz transitória fixada por eventos (placa desconhecida, fim de ciclo…);
  // fora da janela lightUntil, o heartbeat calcula a luz pelo estado real
  lightState    String        @default("OFF")
  lightUntil    DateTime?
  createdAt     DateTime      @default(now())

  // Contadores de lavagem por modelo (espelham NVS do display)
  totalWashesM1  Int       @default(0)
  totalWashesM2  Int       @default(0)
  totalWashesM3  Int       @default(0)
  totalWashesM4  Int       @default(0)
  totalWashesAll Int       @default(0)

  // Controle de licença Pili Tecnologia
  lastPaymentDate    DateTime?
  lastHeartbeatSuccess DateTime?

  station      WashStation   @relation(fields: [stationId], references: [id])
  reservations Reservation[]

  @@index([stationId])
}

// Reserva: segura o valor por 1h; débito só em COMPLETED (AUTO_CONCLUIDO)
model Reservation {
  id          String            @id @default(cuid())
  userId      String
  vehicleId   String
  stationId   String?
  machineId   String?           // alocada quando vira ACTIVE
  programId   Int
  amountCents Int               // preço no momento da reserva
  status      ReservationStatus @default(HELD)
  expiresAt   DateTime          // createdAt + 1h (congela enquanto espera na fila)
  activeAt    DateTime?         // placa reconhecida, verde aceso
  enteredAt   DateTime?         // X14 detectou
  completedAt DateTime?         // AUTO_CONCLUIDO — débito
  orderId     String?           @unique // Order criada só no COMPLETED
  createdAt   DateTime          @default(now())

  user     User         @relation(fields: [userId], references: [id])
  vehicle  Vehicle      @relation(fields: [vehicleId], references: [id])
  station  WashStation? @relation(fields: [stationId], references: [id])
  machine  Machine?     @relation(fields: [machineId], references: [id])
  program  Program      @relation(fields: [programId], references: [id])
  order    Order?       @relation(fields: [orderId], references: [id])
  arrivals Arrival[]

  @@index([userId, status])
  @@index([vehicleId, status])
  @@index([status, expiresAt])
  @@index([machineId, status])
}

// Log de eventos p/ contagens e auditoria (lavagens, recargas, resgates…)
model Event {
  id        String   @id @default(cuid())
  type      String // otp_sent, user_created, topup_paid, order_created, order_redeemed…
  payload   Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

// Capturas da câmera LPR (foto + resultado) — histórico visível em /capturas
model Capture {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  bytes      Int
  jpeg       Bytes
  plate      String?
  score      Float?
  status     String?
  light      String?
  note       String?
  clientName String?

  @@index([at])
}
